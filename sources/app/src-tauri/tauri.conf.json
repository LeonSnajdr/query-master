{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "QueryMaster",
    "version": "0.0.0",
    "identifier": "app.querymaster.desktop",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "QueryMaster",
                "decorations": false,
                "width": 1360,
                "height": 860,
                "minWidth": 860,
                "minHeight": 520
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
            "dangerousDisableAssetCspModification": ["style-src"]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "publisher": "Leon Snajdr",
        "copyright": "© 2026 Leon Snajdr. Prosperity Public License 3.0.0",
        "category": "DeveloperTool",
        "shortDescription": "A MongoDB client",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREODA2NjhBQUVGNkNGNjcKUldSbnovYXVpbWFBM2R4N1NOWGlDNng0WEoxMGpId2FUcUVITWgrVEZkU2l3eHRVOHBHL3diYXMK",
            "endpoints": [
                "https://github.com/LeonSnajdr/query-master/releases/latest/download/latest.json"
            ]
        }
    }
}
