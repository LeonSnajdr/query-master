{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "src/**/*",
        "src/**/*.vue",
        "i18n/**/*"
    ],
    "compilerOptions": {
        "composite": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "noUncheckedIndexedAccess": true
    }
}
