{
    "name": "query-master",
    "private": true,
    "type": "module",
    "version": "0.1.0",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --build --force && bun run build:runtime && vite build",
        "build:runtime": "vite build --config vite.runtime.config.ts",
        "build-only": "vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc --build --force",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
        "e2e": "pwsh -File tools/e2e.ps1",
        "e2e:release": "pwsh -File tools/e2e.ps1 -Release",
        "tauri": "tauri",
        "app:dev": "tauri dev",
        "app:build": "tauri build"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.8.1",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/language": "^6.13.1",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.14",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/open-sans": "^5.3.0",
        "@lezer/highlight": "^1.2.5",
        "@tauri-apps/api": "^2.12.3",
        "@tauri-apps/plugin-dialog": "^2.8.2",
        "@vuetify/v0": "^1.2.3",
        "acorn": "^8.19.0",
        "pinia": "^3.0.4",
        "vue": "^3.5.30",
        "vue-i18n": "11"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.0",
        "@stylistic/eslint-plugin": "latest",
        "@tauri-apps/cli": "^2.12.2",
        "@tsconfig/node22": "^22.0.5",
        "@types/node": "^24.12.0",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vue/eslint-config-typescript": "latest",
        "@vue/tsconfig": "^0.9.0",
        "eslint": "^9.39.4",
        "eslint-plugin-vue": "latest",
        "jiti": "latest",
        "playwright-core": "^1.64.0",
        "typescript": "~5.9.3",
        "unocss": "^66.6.6",
        "unplugin-fonts": "^2.0.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.2",
        "vue-tsc": "^3.2.5"
    }
}
